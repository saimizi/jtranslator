WHITESPACE = _{(" " | "\t")}
MARK = { !ASCII_ALPHANUMERIC ~ !NEWLINE ~ ASCII }
word ={ ASCII_ALPHANUMERIC+ }
words = { word ~ (WHITESPACE+ ~ word)* }
headings1 = {("# " | "## " | "### " | "#### " | "##### " | "###### ") ~ (words | MARK)+ ~ NEWLINE}
headings2 = {NEWLINE* ~ (words | MARK)+ ~ NEWLINE ~ ("=="+ | "--"+) ~ NEWLINE}
headings = { (headings1 | headings2)}
italic1 = {"*" ~ (words | (!"*" ~ MARK))+ ~ "*"}
italic2 = {"_" ~ (words | (!"_" ~ MARK))+ ~ "_"}
italic = { (italic1 | italic2) }
bold1 = {"*"{2} ~ (words | (!"*"{2} ~ MARK))+ ~ "*"{2}}
bold2 = {"_"{2} ~ (words | (!"_"{2} ~ MARK))+ ~ "_"{2}}
bold = { (bold1 | bold2) }
singlebreak={NEWLINE{1}}
linebreak=@{(" "{2} ~ NEWLINE | "<br>")}
normal = {!(singlebreak | linebreak | list) ~ (bold | italic | words | MARK)+}
emptyline = {NEWLINE{2}}
paragraph = {((singlebreak | linebreak){0,1} ~ normal)+ ~ emptyline}
non_number_item = {WHITESPACE* ~ ("* " | "- " | "+ ") ~  normal+ ~ NEWLINE}
number_item = {WHITESPACE* ~ ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* ~ ". " ~ normal+ ~ NEWLINE}
itemlist = {(non_number_item+ | number_item+) }
list = {itemlist}

